{
	"name": "nbdev/bersiv-api-response",
	"description": "A Laravel package for standardized JSON API response structures.",
	"homepage": "https://github.com/navidbakhtiary/bersiv-api-response",
	"authors": [
		{
			"name": "Navid Bakhtiary",
			"homepage": "https://github.com/navidbakhtiary",
			"role": "Developer"
		}
	],
	"type": "library",
	"license": "MIT",
	"keywords": [
		"laravel",
		"api",
		"response",
		"json-response",
		"api-response",
		"facade",
		"php"
	],
	"autoload": {
		"psr-4": {
			"NBDev\\BersivApiResponse\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"NBDev\\BersivApiResponse\\Tests\\": "tests/"
		}
	},
	"extra": {
		"laravel": {
			"providers": [
				"NBDev\\BersivApiResponse\\Providers\\BersivApiResponseServiceProvider"
			]
		}
	},
	"require": {
		"php": "^8.2",
		"illuminate/http": "^11.0",
		"illuminate/support": "^11.0"
	},
	"require-dev": {
		"laravel/pint": "^1.0",
		"orchestra/testbench": "^9.11",
		"phpunit/phpunit": "^11.5",
		"larastan/larastan": "^3.0"
	},
	"scripts": {
		"test": "phpunit",
		"pint": "pint",
		"pint-test": "pint --test",
		"analyse": "phpstan analyse -c phpstan.neon"
	},
	"minimum-stability": "stable",
	"prefer-stable": true
}